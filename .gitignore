# Run outputs. runs/LEDGER.md remains the versioned compute appendix.
/runs/*
!/runs/LEDGER.md

# Local dataset cache. The self-contained Kaggle upload archive is allowed
# explicitly below, so the raw/cache copy is not duplicated in the repository.
/data/

# Intermediate bundles, rebuilt by scripts/package_for_kaggle.py.
/dist/

# Publish only the exact artifacts currently uploaded for the neuron-methods
# Kaggle run; keep the other generated/staged notebooks local.
/kaggle_upload/*
!/kaggle_upload/1_DATASET_neuron-death-code.zip
!/kaggle_upload/2_neuron_methods.ipynb
!/kaggle_upload/README.txt

# Python/editor caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
